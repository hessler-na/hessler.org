---
import faq from "../../content/streetfair-faq.json"
import Accordion from "../starwind/accordion/Accordion.astro"
import AccordionItem from "../starwind/accordion/AccordionItem.astro"
import AccordionContent from "../starwind/accordion/AccordionContent.astro"
import AccordionTrigger from "../starwind/accordion/AccordionTrigger.astro"


interface FAQItem {
  id: string
  question: string
  answer: string
}
---

<div class="prose-modern">
  <Accordion>
    {
      faq.map((item: FAQItem) => (
        <AccordionItem value={item.id}>
          <AccordionTrigger class="">
            <h3>{item.question}</h3>
          </AccordionTrigger>

          <AccordionContent class="">
            {item.answer}
          </AccordionContent>
        </AccordionItem>
      ))
    }
  </Accordion>
</div>
